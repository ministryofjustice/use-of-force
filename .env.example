# Use of Force - local environment template
#
# Copy to .env and adjust:   cp .env.example .env
#
# IMPORTANT: .env is only loaded by `npm run start:dev` (and `start-feature:dev`),
# because only the `watch-node` / `watch-node-feature` scripts pass `-r dotenv/config`.
# It is NOT read by `npm run start-feature`, by `node dist/server.js`, or in deployed
# environments. See docs/getting-started.md.
#
# Every variable below has a default in server/config.ts, so the app will start with
# none of these set. The ones marked REQUIRED IN PRODUCTION throw `Missing env var X`
# at boot when NODE_ENV=production and they are absent.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# docker-compose.yml publishes postgres on host port 5433, but config.ts defaults
# DB_PORT to 5432. Set this or the app talks to the wrong database.
DB_SERVER=localhost
DB_PORT=5433
DB_NAME=use-of-force
DB_USER=use-of-force
DB_PASS=use-of-force
DB_SSL_ENABLED=false

# ---------------------------------------------------------------------------
# Redis (sessions and the system-token cache)
# ---------------------------------------------------------------------------
# REDIS_ENABLED=false uses an in-memory session store instead. REQUIRED IN PRODUCTION.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS_ENABLED=false
# REDIS_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION - supplied from the `use-of-force` k8s secret.
SESSION_SECRET=app-insecure-default-session
WEB_SESSION_TIMEOUT_IN_MINUTES=120

# ---------------------------------------------------------------------------
# HMPPS Auth (OAuth2) - all REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# NOMIS_AUTH_URL is the server-to-server token endpoint; NOMIS_AUTH_EXTERNAL_URL is
# the browser-facing authorize endpoint and falls back to NOMIS_AUTH_URL when unset.
NOMIS_AUTH_URL=http://localhost:9090/auth
# NOMIS_AUTH_EXTERNAL_URL=
API_CLIENT_ID=use-of-force-client
API_CLIENT_SECRET=clientsecret
# SYSTEM_* fall back to API_* when unset. Used for client-credentials calls.
# SYSTEM_CLIENT_ID=
# SYSTEM_CLIENT_SECRET=

# Token verification. Disabled locally; the app skips per-request token checks.
TOKENVERIFICATION_API_URL=http://localhost:8100
TOKENVERIFICATION_API_ENABLED=false

# ---------------------------------------------------------------------------
# Upstream APIs - all REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
PRISON_API_URL=http://localhost:8080
HMPPS_MANAGE_USERS_API_URL=http://localhost:8081
PRISONER_SEARCH_API_URL=http://localhost:8080
LOCATIONS_INSIDE_PRISON_API_URL=http://localhost:8080
NOMIS_MAPPING_API_URL=http://localhost:8080
COMPONENT_API_URL=http://localhost:8082

# Every API also accepts <NAME>_TIMEOUT_RESPONSE and <NAME>_TIMEOUT_DEADLINE
# (milliseconds, default 10000; the frontend components API uses
# COMPONENT_API_TIMEOUT_SECONDS, default 2000).

# ---------------------------------------------------------------------------
# URLs - all REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# INGRESS_URL is this app's own base URL; the OAuth callback is built from it.
INGRESS_URL=http://localhost:3000
DPS_URL=http://localhost:3000
# Base URL used in emailed deep links (statement reminders, removal requests).
EMAIL_LOCATION_URL=http://localhost:3000
# Where the "Exit" link in the header goes.
EXIT_LOCATION_URL=/

# ---------------------------------------------------------------------------
# GOV.UK Notify
# ---------------------------------------------------------------------------
# NOTIFY_API_KEY is REQUIRED IN PRODUCTION.
NOTIFY_API_KEY=invalid-token
# WARNING: do not set NOTIFY_ENABLED=true expecting real emails. config.email.enabled
# holds the *string* 'true' but notificationService.ts compares `enabled === true`, so
# setting this variable at all currently disables sending. Leaving it unset lets the
# boolean default through, which is why it works in deployed environments.
# NOTIFY_ENABLED=
# TEMPLATE_REPORTER_REMINDER=
# TEMPLATE_REPORTER_OVERDUE=

# Secret used to sign the unauthenticated statement-removal deep links.
# REQUIRED IN PRODUCTION.
URL_SIGNING_SECRET=someUrlSigningSecret

# ---------------------------------------------------------------------------
# Feature flags and behaviour
# ---------------------------------------------------------------------------
# Weeks after the incident date during which a report may still be submitted or edited.
MAX_WEEKS_TO_SUBMIT_OR_EDIT_REPORT=13
# Comma-separated prison codes that use the locations API for non-residential
# locations instead of NOMIS cell locations. Do NOT quote the value.
FEATURE_FLAG_REMOVE_CELL_LOCATION_AGENCIES=
# REQUIRED IN PRODUCTION.
FEATURE_FLAG_OUTAGE_BANNER_ENABLED=false
# Shown in the environment banner. Empty in production.
ENVIRONMENT_NAME=DEV

# ---------------------------------------------------------------------------
# Build info - REQUIRED IN PRODUCTION, injected by the Docker build
# ---------------------------------------------------------------------------
# BUILD_NUMBER=1_0_0
# PRODUCT_ID=DPS045
# GIT_REF=
# GIT_BRANCH=

# ---------------------------------------------------------------------------
# Telemetry - optional, leave unset locally
# ---------------------------------------------------------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# TAG_MANAGER_KEY=
# TAG_MANAGER_ENVIRONMENT=
